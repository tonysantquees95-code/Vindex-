<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/widget_fundo">
    <TextView android:id="@+id/w_titulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Vindex · Desempenho" android:textColor="#7DE3FF" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_ram" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
    <ProgressBar android:id="@+id/w_barra" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"
        android:max="100" android:progress="0" />
    <TextView android:id="@+id/w_temp" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#A0CDEB" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/w_liberar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:padding="6dp" android:gravity="center"
        android:text="Liberar RAM" android:textColor="#04121C" android:textStyle="bold" android:background="@drawable/widget_botao" />
</LinearLayout>
